<?xml version="1.0" encoding="utf-8"?>
<!-- Lightweight native splash: instant brand paint, no bitmap decode, replaced once Flutter draws its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#043927" />
        </shape>
    </item>

    <!-- Optional: drop a launch_image.png into drawable/ and uncomment below
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
    -->
</layer-list>
