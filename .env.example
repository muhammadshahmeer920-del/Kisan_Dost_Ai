# Copy this file to .env and fill in your real values.
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000
NODE_ENV=development

# VITE_GOOGLE_MAPS_API_KEY: Required for the interactive 'Nearby Veterinary Map' service.
# Create an API key in Google Cloud Console (Maps JavaScript API + Places API enabled):
# https://console.cloud.google.com/google/maps-apis/credentials
# Client-side only (VITE_ prefix exposes it to the browser). When missing or invalid,
# the map gracefully falls back to an 'Open in Google Maps' link.
VITE_GOOGLE_MAPS_API_KEY=your_key

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key for signing JWT authentication tokens.
# In production, use a strong random string (e.g., openssl rand -base64 32).
JWT_SECRET=change_in_production

# SQLITE_PATH: Optional custom path for the SQLite database file.
# Defaults to ./data/kisan_dost.db (auto-created on first run).
# SQLITE_PATH=/custom/path/to/database.db

